# Environment configuration for the Truck Signs API.
# Copy this file to .env and fill in the values. .env is listed in
# .gitignore and must never be committed.
#
# Every variable below has to be set. settings.py reads a few further
# optional ones; the README documents all of them.


# --- Database --------------------------------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
# Has to match the name of the database service in docker-compose.yml.
DB_HOST=db
DB_PORT=5432


# --- Django ----------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Wrap the value in single quotes; a generated key may contain '#'.
SECRET_KEY=

# Comma separated, no spaces. Add the host that serves the API.
ALLOWED_HOSTS=localhost,127.0.0.1


# --- Admin account, created by entrypoint.sh -------------------------
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=


# --- Local development without Docker --------------------------------
# dev uses SQLite, prod uses PostgreSQL. docker-compose.yml sets prod
# for the container, so this only affects manage.py in a virtualenv.
MODE=dev
